# Used server-side only, in src/app/api/ask/route.ts and src/lib/embeddings.ts —
# generates real answers and real embeddings for the knowledge base. Never
# exposed to the client (no NEXT_PUBLIC_ prefix).
GEMINI_API_KEY=
# Optional override — defaults to gemini-flash-latest (a live-updating
# alias) if unset.
GEMINI_MODEL=
# Optional override — defaults to gemini-embedding-001 if unset. Verified
# directly against the live API (text-embedding-004, the model named in
# the installed SDK's own doc comments, 404s on this API — do not use it).
GEMINI_EMBEDDING_MODEL=
